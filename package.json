{
  "name": "cine",
  "version": "0.1.0",
  "private": true,
  "description": "Headless cinematic screen recorder — autonomous capture, auto-zoom, and rendering for agent-driven demos",
  "type": "module",
  "bin": {
    "cine": "./bin/cine.mjs"
  },
  "scripts": {
    "build:native": "cc -O2 -framework ApplicationServices -o src/platform/macos/cursor-logger src/platform/macos/cursor-logger.c",
    "demo": "node bin/cine.mjs demo",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "puppeteer-core": "^24.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "electron": "^35.7.5"
  }
}
